{
  "name": "scheduler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run verify:shuffle && npm run verify:queue && npm run verify:performance && npm run verify:shape && npm run build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy && node scripts/smoke.mjs",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "types:db": "supabase gen types typescript --linked > src/lib/database.types.generated.ts",
    "db:apply": "node scripts/apply-migrations.mjs",
    "verify:shuffle": "tsx scripts/verify-shuffle.ts",
    "verify:queue": "tsx scripts/verify-queue.ts",
    "verify:performance": "tsx scripts/verify-performance.ts",
    "verify:shape": "tsx scripts/verify-shape.ts",
    "verify:retry": "tsx scripts/verify-retry.ts",
    "verify:new-post": "tsx scripts/verify-new-post.ts",
    "smoke": "node scripts/smoke.mjs",
    "cpu": "node scripts/cpu.mjs",
    "verify:typography": "tsx scripts/verify-typography.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "date-fns": "^4.4.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@opennextjs/cloudflare": "^1.20.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "unrs-resolver": true
  }
}
