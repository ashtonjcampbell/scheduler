# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Leading slash would only cover the root; worker/ has its own install.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Committed on purpose: it documents the required variables and holds no values.
!.env.example

# Cloudflare
.open-next/
.wrangler/
cloudflare-env.d.ts

# Worker (GitHub Actions) build output
worker/dist/
.dev.vars

# A real session, cached by the smoke test so repeated runs stop
# rate-limiting themselves against Supabase.
.smoke-session.json
