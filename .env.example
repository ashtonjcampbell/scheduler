# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local — this repo is public.
# ---------------------------------------------------------------------------

# Supabase project. Both of these are safe in the browser: the anon key only
# grants what Row Level Security allows.
# Found under Project Settings -> API in the Supabase dashboard.
#
# NOTE: these two are read at BUILD time (Next.js inlines NEXT_PUBLIC_* into
# the browser bundle), so on Cloudflare they must be set as build environment
# variables, not as Worker secrets.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The only address allowed to sign in.
ALLOWED_EMAIL=hello@wilderpines.com

# Public origin of the app, used to build magic-link redirects.
# Locally this is http://localhost:3000.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Worker only (GitHub Actions). Never set these in the web app.
# ---------------------------------------------------------------------------

# Service-role key: bypasses Row Level Security entirely. Treat like a
# password. Store it as a GitHub Actions secret, nowhere else.
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Optional: makes photo processing start immediately instead of waiting for
# the next scheduled sweep. Without these the app still works — photos just
# take up to 20 minutes rather than about a minute.
#
# The token needs only "Contents: read and write" on this one repository.
# ---------------------------------------------------------------------------
# GITHUB_REPO=your-username/ig-scheduler
# GITHUB_DISPATCH_TOKEN=
